# Leave unset to use the no-key Google-compatible endpoint.
OSLT_TRANSLATOR=google-compatible

# Optional proxy for the default provider.
# OSLT_TRANSLATE_ENDPOINT=https://your-proxy.example/translate

# Google Cloud Translation v2.
# OSLT_TRANSLATOR=google-cloud
# OSLT_GOOGLE_CLOUD_API_KEY=replace-me

# DeepL API. Use api-free.deepl.com when appropriate for your account.
# OSLT_TRANSLATOR=deepl
# OSLT_DEEPL_API_KEY=replace-me
# OSLT_DEEPL_ENDPOINT=https://api-free.deepl.com/v2/translate
